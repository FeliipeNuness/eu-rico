# Copy to an ignored local .env only. Network and checkout are disabled by default.
CAKTO_ENVIRONMENT=local
CAKTO_NETWORK_ENABLED=false
CAKTO_API_BASE_URL=http://127.0.0.1:54399
CAKTO_CHECKOUT_BASE_URL=https://checkout.example.invalid
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_SECRET=
# Must match the actual approved offer; no recurrence length is assumed.
CAKTO_RECURRENCE_DAYS=
BILLING_RECONCILE_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
# Mercado Pago is independently disabled; never put these secrets in VITE_ variables.
BILLING_ENVIRONMENT=local
MP_ENVIRONMENT=test
MP_NETWORK_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MP_APPLICATION_ID=
