{
  "name": "eu-rico",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty",
    "test": "node tests/run-tests.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "test:db": "node tests/database.mjs",
    "dev:staging": "vite --configLoader runner --mode staging --host 127.0.0.1 --port 5176 --strictPort",
    "build:staging": "tsc -b && vite build --configLoader runner --mode staging",
    "preview:staging": "vite preview --configLoader runner --mode staging --host 127.0.0.1 --port 4178 --strictPort",
    "test:staging-target": "node tests/staging-target.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7"
  }
